# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# JWT_SECRET: Secret key used to sign and verify JSON Web Tokens for authentication.
JWT_SECRET="allcardstation_super_secret_jwt_key_phase2_dev"

# DATABASE_URL: PostgreSQL connection string (e.g. postgresql://user:password@localhost:5432/allcardstation)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/allcardstation?schema=public"
